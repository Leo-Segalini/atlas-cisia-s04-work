# Planificateur DiagOps M6 — exemples (ne pas committer de secrets)

# heuristic | ollama | huggingface
DIAGOPS_PLANNER=heuristic

# --- Ollama (local) ---
# DIAGOPS_PLANNER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# DIAGOPS_OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Hugging Face Inference (cloud) ---
